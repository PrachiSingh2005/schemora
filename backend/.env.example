FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

GROQ_API_KEY=your_groq_api_key_here
GROQ_GENERATION_MODEL=openai/gpt-oss-20b
